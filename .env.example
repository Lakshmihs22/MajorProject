REDIS_HOST=redis
REDIS_PORT=6379
SQLITE_PATH=/data/edgeshield.db
DASHBOARD_BACKEND_PORT=8000
DASHBOARD_FRONTEND_PORT=3000

# Person B score decay and resolution settings (seconds, except points).
SCORE_DECAY_GRACE_SECONDS=300
SCORE_DECAY_INTERVAL_SECONDS=300
SCORE_DECAY_POINTS_PER_INTERVAL=5
CHAIN_RESOLUTION_LOW_MEDIUM_SECONDS=1800
CHAIN_RESOLUTION_HIGH_SECONDS=3600
CHAIN_RESOLUTION_CRITICAL_SECONDS=7200
